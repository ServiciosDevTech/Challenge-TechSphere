# Google AI Studio — required from Etapa 2 (agent)
# Create at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini Flash model id (allowed family per Tech Sphere stack)
GEMINI_MODEL=gemini-flash-latest

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paths (relative to backend/ or absolute)
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
CALLS_DIR=./data/calls
METRICS_DIR=./data/metrics

# RAG
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Voice TTS (edge-tts voice)
TTS_VOICE=es-CO-SalomeNeural
